# ============================================
# 3rike Mobility — Terraform Environment Setup
# ============================================
# Copy this to .env, fill in your values, then:
#   source .env && terraform plan
# ============================================

# --- AWS Credentials ---
# Get these from IAM User in AWS Console
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# --- Terraform Variables (TF_VAR_ prefix) ---
TF_VAR_db_password=your-strong-password-here
TF_VAR_apn_id=arn:aws:apn:...   # Get from Arthurite organizers
